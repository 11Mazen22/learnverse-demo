{
  "name": "noata",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @noata/web dev",
    "build": "pnpm --filter @noata/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm build",
    "legacy:check": "node --check server.mjs && node --test --test-isolation=none",
    "modern:test": "node --test apps/web/lib/ai/*.test.ts packages/core/src/core.test.ts",
    "verify": "pnpm typecheck && pnpm modern:test && pnpm build && pnpm legacy:check"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
